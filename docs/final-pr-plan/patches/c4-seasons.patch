new file mode 100644
index 0000000..332a6bd
--- /dev/null
+++ b/src/components/garden/Fireflies.test.tsx
@@ -0,0 +1,75 @@
+import { act, render } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Fireflies, FIREFLY_COUNT } from './Fireflies'
+
+/** A device whose reduced-motion preference is as given, and can change. */
+function preferReducedMotion(reduce: boolean) {
+  const listeners = new Set<() => void>()
+  const list = {
+    matches: reduce,
+    addEventListener: (_: string, listener: () => void) => listeners.add(listener),
+    removeEventListener: (_: string, listener: () => void) => listeners.delete(listener),
+  }
+  vi.stubGlobal('matchMedia', (query: string) => {
+    expect(query).toBe('(prefers-reduced-motion: reduce)')
+    return list
+  })
+  return (next: boolean) => {
+    list.matches = next
+    listeners.forEach((listener) => listener())
+  }
+}
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+})
+
+describe('fireflies', () => {
+  it('are a handful of small lights, hidden from assistive technology', () => {
+    preferReducedMotion(false)
+    const { container } = render(<Fireflies />)
+    const field = container.querySelector('.hero-fireflies')
+    expect(field).toHaveAttribute('aria-hidden', 'true')
+    expect(container.querySelectorAll('.hero-firefly')).toHaveLength(FIREFLY_COUNT)
+    expect(FIREFLY_COUNT).toBeLessThanOrEqual(6)
+  })
+
+  it('are not drawn at all where the device asks for reduced motion, and leave when it does', () => {
+    const change = preferReducedMotion(true)
+    const { container } = render(<Fireflies />)
+    expect(container.querySelector('.hero-firefly')).toBeNull()
+
+    act(() => change(false))
+    expect(container.querySelectorAll('.hero-firefly')).toHaveLength(FIREFLY_COUNT)
+    act(() => change(true))
+    expect(container.querySelector('.hero-fireflies')).toBeNull()
+  })
+
+  it('pause while out of view, like the scene’s sprites', () => {
+    preferReducedMotion(false)
+    let report: IntersectionObserverCallback | undefined
+    const observed: Element[] = []
+    vi.stubGlobal(
+      'IntersectionObserver',
+      class {
+        constructor(callback: IntersectionObserverCallback) {
+          report = callback
+        }
+        observe(element: Element) {
+          observed.push(element)
+        }
+        disconnect() {}
+      },
+    )
+    const { container } = render(<Fireflies />)
+    const field = container.querySelector('.hero-fireflies')!
+    expect(observed).toContain(field)
+
+    const seen = (isIntersecting: boolean) =>
+      report?.([{ target: field, isIntersecting } as unknown as IntersectionObserverEntry], {} as IntersectionObserver)
+    seen(false)
+    expect(field).toHaveAttribute('data-offscreen')
+    seen(true)
+    expect(field).not.toHaveAttribute('data-offscreen')
+  })
+})
diff --git a/src/components/garden/Fireflies.tsx b/src/components/garden/Fireflies.tsx
new file mode 100644
index 0000000..77c3574
--- /dev/null
+++ b/src/components/garden/Fireflies.tsx
@@ -0,0 +1,43 @@
+import { useEffect, useRef } from 'react'
+import { useMediaQuery } from '../../hooks/useMediaQuery'
+import './fireflies.css'
+
+/** A handful, so the night stays calm and the compositor's work small. */
+export const FIREFLY_COUNT = 5
+
+/**
+ * Fireflies drifting low over the night garden, in place of the day's falling
+ * petals (plan b G5). GardenView loads them only at night and only with full
+ * motion: never with reduced motion (the setting, which is the shell's
+ * `.reduce-motion`) or Calm motion. The device's own reduced-motion
+ * preference is checked here, where the garden itself does not look.
+ *
+ * Each firefly is a small glowing dot whose drift is a transform and whose
+ * glow is its opacity, both on its own composited layer, so the main thread
+ * does nothing while they move; no React render happens per frame. Out of
+ * view they pause, marked `data-offscreen` as the sprites are (SpriteFrame),
+ * and a hidden tab pauses them with everything else (`.page-hidden`). Their
+ * observer is their own, so the garden's first load gains nothing for them.
+ */
+export function Fireflies() {
+  const reduced = useMediaQuery('(prefers-reduced-motion: reduce)')
+  const field = useRef<HTMLDivElement>(null)
+  useEffect(() => {
+    const element = field.current
+    if (!element || typeof IntersectionObserver === 'undefined') return
+    const observer = new IntersectionObserver(
+      ([entry]) => element.toggleAttribute('data-offscreen', !entry.isIntersecting),
+      { rootMargin: '64px' },
+    )
+    observer.observe(element)
+    return () => observer.disconnect()
+  }, [reduced])
+  if (reduced) return null
+  return (
+    <div className="hero-fireflies" aria-hidden="true" ref={field}>
+      {Array.from({ length: FIREFLY_COUNT }, (_, index) => (
+        <span key={index} className={`hero-firefly firefly-${index + 1}`} />
+      ))}
+    </div>
+  )
+}
