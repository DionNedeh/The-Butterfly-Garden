+/**
+ * Reading a QR code with the camera, where the browser can: the Shape
+ * Detection API's BarcodeDetector, with 'qr_code' among its formats (Chrome
+ * on Android, and a few others), and a camera through getUserMedia.
+ *
+ * Everything is asked for, never assumed. Safari, Firefox and the Android
+ * app's WebView do not have BarcodeDetector today, and there the move's
+ * screen simply does not offer to scan: typing the words works everywhere.
+ * The app adds no decoder of its own and asks for no Android permission.
+ *
+ * Loaded only with the arriving screen.
+ */
+
+/** The little of BarcodeDetector the move uses. Not in TypeScript's DOM types yet. */
+export interface QrDetector {
+  detect(source: HTMLVideoElement): Promise<Array<{ rawValue: string }>>
+}
+
+interface DetectorClass {
+  new (options: { formats: string[] }): QrDetector
+  getSupportedFormats(): Promise<string[]>
+}
+
+function detectorClass(): DetectorClass | undefined {
+  const found = (globalThis as { BarcodeDetector?: unknown }).BarcodeDetector
+  return typeof found === 'function' ? (found as DetectorClass) : undefined
+}
+
+/**
+ * A QR detector and a way to the camera, or undefined where either is
+ * missing. Asking does not touch the camera: that waits for a tap.
+ */
+export async function qrDetector(): Promise<QrDetector | undefined> {
+  const Detector = detectorClass()
+  if (!Detector || typeof navigator.mediaDevices?.getUserMedia !== 'function') return undefined
+  try {
+    const formats = await Detector.getSupportedFormats()
+    if (!formats.includes('qr_code')) return undefined
+    return new Detector({ formats: ['qr_code'] })
+  } catch {
+    return undefined
+  }
+}
+
+/** The camera that faces away from the gardener, where there is one, and no sound. */
+export function openCamera(): Promise<MediaStream> {
+  return navigator.mediaDevices.getUserMedia({
+    video: { facingMode: { ideal: 'environment' } },
+    audio: false,
+  })
+}
+
+/** Let go of the camera: every track stopped, so its light goes out at once. */
+export function stopCamera(stream: MediaStream | undefined): void {
+  for (const track of stream?.getTracks() ?? []) track.stop()
+}
+
+/** By name: a DOMException is not an Error in every engine. */
+function nameOf(error: unknown): string | undefined {
+  return typeof error === 'object' && error !== null
+    ? ((error as { name?: unknown }).name as string | undefined)
+    : undefined
+}
+
+/** Why the camera did not open, in words, with the way that always works. */
+export function cameraProblem(error: unknown): string {
+  switch (nameOf(error)) {
+    case 'NotAllowedError':
+    case 'SecurityError':
+      return 'The camera was not allowed, so nothing was scanned. You can type the 12 words instead.'
+    case 'NotFoundError':
+    case 'OverconstrainedError':
+      return 'No camera was found here. You can type the 12 words instead.'
+    case 'NotReadableError':
+    case 'AbortError':
+      return 'The camera is busy with something else just now. You can type the 12 words instead.'
+    default:
+      return 'The camera could not be opened. You can type the 12 words instead.'
+  }
+}
diff --git a/src/lib/sealedBackup.move.test.ts b/src/lib/sealedBackup.move.test.ts
new file mode 100644
index 0000000..4afd847
--- /dev/null
+++ b/src/lib/sealedBackup.move.test.ts
@@ -0,0 +1,47 @@
+import { describe, expect, it } from 'vitest'
+import { isSealedBackup } from './backupFile'
+import { newMoveCode, moveSecret } from './moveCode'
+import { openSealedBackup, readSealedBackup, sealBackup } from './sealedBackup'
+
+const PLAIN = '{"format":"the-butterfly-garden","garden":{"note":"Brought across"}}'
+
+describe('a move file’s envelope', () => {
+  it('is a protected backup, marked as opened by a move code, the mark after the format', async () => {
+    const words = await newMoveCode()
+    const outcome = await sealBackup(PLAIN, moveSecret(words), { iterations: 1_000, opensWith: 'move-code' })
+    if (!outcome.ok) throw new Error('Not sealed')
+    expect(isSealedBackup(outcome.text)).toBe(true)
+    const envelope = JSON.parse(outcome.text) as Record<string, unknown>
+    expect(Object.keys(envelope)[0]).toBe('format')
+    expect(envelope.opensWith).toBe('move-code')
+    // The ciphertext stays last, so the rest can be read at the top of the file.
+    expect(Object.keys(envelope).at(-1)).toBe('ciphertext')
+    const read = readSealedBackup(outcome.text)
+    expect(read.ok && read.backup.opensWith).toBe('move-code')
+    if (read.ok) expect(await openSealedBackup(read.backup, moveSecret(words))).toBe(PLAIN)
+  })
+
+  it('carries no mark for a passphrase, and an unknown mark is read as none', async () => {
+    const outcome = await sealBackup(PLAIN, 'quiet meadow lantern', { iterations: 1_000 })
+    if (!outcome.ok) throw new Error('Not sealed')
+    expect(outcome.text).not.toContain('opensWith')
+    const read = readSealedBackup(outcome.text)
+    expect(read.ok && 'opensWith' in read.backup).toBe(false)
+
+    const marked = outcome.text.replace('"formatVersion": 1,', '"formatVersion": 1,\n  "opensWith": "something-else",')
+    const other = readSealedBackup(marked)
+    expect(other.ok && 'opensWith' in other.backup).toBe(false)
+  })
+
+  it('binds nothing to the mark: taking it off leaves a file the words still open', async () => {
+    const words = await newMoveCode()
+    const outcome = await sealBackup(PLAIN, moveSecret(words), { iterations: 1_000, opensWith: 'move-code' })
+    if (!outcome.ok) throw new Error('Not sealed')
+    const unmarked = outcome.text.replace(/\n {2}"opensWith": "move-code",/, '')
+    expect(unmarked).not.toContain('opensWith')
+    const read = readSealedBackup(unmarked)
+    if (!read.ok) throw new Error('Not read')
+    expect(read.backup.opensWith).toBeUndefined()
+    expect(await openSealedBackup(read.backup, moveSecret(words))).toBe(PLAIN)
+  })
+})
