@@ -0,0 +1,28 @@
+import { useMemo } from 'react'
+import { encodeQr, qrPath } from '../../lib/qrCode'
+
+/** The light margin a reader needs around a code: four modules, as the standard asks. */
+const QUIET_ZONE = 4
+
+/**
+ * Text as a QR code, drawn here as one SVG path (lib/qrCode). Black on
+ * white in both themes, on purpose: a camera reads a dark code on a light
+ * ground, and many cannot read one the other way round. Its words are given
+ * beside it, so the picture is named, not read out.
+ */
+export function QrPicture({ text, label }: { text: string; label: string }) {
+  const code = useMemo(() => encodeQr(text), [text])
+  const side = code.size + 2 * QUIET_ZONE
+  return (
+    <svg
+      className="move-qr"
+      viewBox={`0 0 ${side} ${side}`}
+      role="img"
+      aria-label={label}
+      shapeRendering="crispEdges"
+    >
+      <rect width={side} height={side} fill="#fff" />
+      <path d={qrPath(code, QUIET_ZONE)} fill="#000" />
+    </svg>
+  )
+}
diff --git a/src/components/move/move.css b/src/components/move/move.css
new file mode 100644
index 0000000..d177557
--- /dev/null
+++ b/src/components/move/move.css
@@ -0,0 +1,142 @@
+/* The move between devices: the move file and its one-time code on the old
+   device, and opening it on the new one. Loaded with the screens that offer
+   them (Settings, the welcome, the recovery screen), never with the garden.
+   Surfaces, ink and the backdrop are the shared .garden-dialog's, so both
+   themes are covered; the only colours added are the QR code's and the
+   camera's, which stay as they are by night too. */
+
+.move-dialog {
+  width: min(36rem, calc(100% - 2rem));
+}
+
+.move-dialog h2 {
+  margin: 0.2rem 0 0.6rem;
+  overflow-wrap: anywhere;
+}
+
+.move-dialog form {
+  display: grid;
+}
+
+.move-dialog .form-actions {
+  margin-top: 0.4rem;
+}
+
+/* Every way in and every quieter choice inside is a full touch target. */
+.arrive-button,
+.move-dialog .text-button {
+  min-height: 44px;
+}
+
+.move-dialog .file-button {
+  justify-self: start;
+  margin-bottom: 0.6rem;
+}
+
+.move-dialog textarea {
+  min-height: 5.5rem;
+  resize: vertical;
+  font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
+}
+
+/* The hint sits close under the field it describes. */
+.move-dialog .move-hint {
+  margin: -0.6rem 0 1rem;
+}
+
+.move-dialog .move-progress {
+  margin: 0;
+  color: var(--text-soft);
+  font-weight: 700;
+}
+
+/* Empty live regions keep their place in the page, so what arrives in them
+   is heard, but take no room until then. */
+.move-dialog .move-progress:empty,
+.move-dialog .move-problem:empty {
+  margin: 0;
+}
+
+/* What to keep in mind, set apart by the gold rule the lock's warnings use. */
+.move-note {
+  margin: 0 0 0.8rem;
+  border-left: 4px solid var(--gold);
+  border-radius: 0 12px 12px 0;
+  background: var(--surface-soft);
+  padding: 0.75rem 0.9rem;
+  color: var(--ink);
+  line-height: 1.55;
+}
+
+.theme-night .move-note {
+  border-left-color: #e7c27a;
+}
+
+/* The code and its picture side by side where there is room, the picture
+   first on a phone. */
+.move-code {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
+  gap: 1rem;
+  align-items: start;
+  margin: 0.4rem 0 1rem;
+}
+
+/* Black on white by day and by night alike, with the white margin a reader
+   needs: a camera reads a dark code on a light ground, and many cannot read
+   one inverted. The edge keeps it from melting into a light card. */
+.move-qr {
+  display: block;
+  width: 100%;
+  max-width: 15rem;
+  height: auto;
+  margin: 0 auto;
+  border: 1px solid var(--edge);
+  border-radius: 10px;
+  background: #fff;
+}
+
+.theme-night .move-qr {
+  border-color: transparent;
+  background: #fff;
+}
+
+.move-words {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
+  gap: 0.35rem 1rem;
+  margin: 0;
+  border: 1px solid var(--edge);
+  border-radius: 14px;
+  background: var(--surface-soft);
+  padding: 0.85rem 1rem 0.85rem 2.4rem;
+  font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
+  font-size: 1rem;
+}
+
+.move-words li {
+  padding-left: 0.2rem;
+  color: var(--ink);
+  overflow-wrap: anywhere;
+}
+
+/* The viewfinder: the camera's own picture, black until it arrives. */
+.move-scanner {
+  display: grid;
+  gap: 0.5rem;
+  margin-bottom: 1rem;
+}
+
+.move-camera {
+  display: block;
+  width: 100%;
+  max-height: 45svh;
+  aspect-ratio: 4 / 3;
+  object-fit: cover;
+  border-radius: 14px;
+  background: #000;
+}
+
+.theme-night .move-camera {
+  background: #000;
+}
diff --git a/src/lib/moveCode.test.ts b/src/lib/moveCode.test.ts
