+import { describe, expect, it } from 'vitest'
+import { readText } from '../test/woff2'
+import {
+  alignmentPositions,
+  dataCodewords,
+  encodeQr,
+  penalty,
+  qrPath,
+  reedSolomon,
+  type QrCode,
+} from './qrCode'
+
+/**
+ * Known-good codes, made by an independent encoder (Project Nayuki's
+ * qrcodegen 1.8.0, byte mode, level M, never raising the level): three in
+ * full, module by module, and the rest as a SHA-256 of their modules, for
+ * every version from 1 to 40, every mask, and two dozen move codes. Its
+ * generator is described in the fixture's `source`.
+ */
+interface Fixtures {
+  filler: string
+  full: { text: string; version: number; mask: number; rows: string[] }[]
+  versions: { length: number; version: number; mask: number; sha256: string }[]
+  masks: { text: string; version: number; mask: number; sha256: string }[]
+  codes: { text: string; version: number; mask: number; sha256: string }[]
+}
+// Through a variable: Vite would otherwise take `new URL(…, import.meta.url)` for an asset.
+const here = import.meta.url
+const fixtures = JSON.parse(readText(new URL('../test/qrFixtures.json', here))) as Fixtures
+
+const rows = (code: QrCode) => code.modules.map((row) => row.map((dark) => (dark ? '1' : '0')).join(''))
+
+async function digest(code: QrCode): Promise<string> {
+  const hash = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(rows(code).join('\n')))
+  return Array.from(new Uint8Array(hash), (byte) => byte.toString(16).padStart(2, '0')).join('')
+}
+
+const hex = (text: string) => Uint8Array.from(text.match(/../g) ?? [], (pair) => parseInt(pair, 16))
+
+describe('Reed-Solomon error correction', () => {
+  it('gives the standard’s worked example: 01234567 at version 1-M', () => {
+    // ISO/IEC 18004, annex I: the data codewords and the ten that protect them.
+    const data = hex('10200c56618 0ec11ec11ec11ec11ec11'.replace(/ /g, ''))
+    expect(Array.from(reedSolomon(data, 10))).toEqual(Array.from(hex('a524d4c1ed36c7872c55')))
+  })
+
+  it('gives the well-known HELLO WORLD at version 1-Q, thirteen codewords deep', () => {
+    const data = Uint8Array.from([32, 91, 11, 120, 209, 114, 220, 77, 67, 64, 236, 17, 236])
+    expect(Array.from(reedSolomon(data, 13))).toEqual([
+      168, 72, 22, 82, 217, 54, 156, 0, 46, 15, 180, 122, 16,
+    ])
+  })
+
+  it('leaves no remainder for a codeword that is already a multiple of the generator', () => {
+    // A block followed by its own error correction divides exactly.
+    const data = Uint8Array.from([64, 86, 134, 86, 198, 198, 240, 236, 17, 236])
+    const block = Uint8Array.from([...data, ...reedSolomon(data, 16)])
+    expect(Array.from(reedSolomon(block, 16))).toEqual(Array(16).fill(0))
+  })
+})
+
+describe('the layout', () => {
+  it('puts the alignment patterns where the standard’s table does', () => {
+    expect(alignmentPositions(1)).toEqual([])
+    expect(alignmentPositions(2)).toEqual([6, 18])
+    expect(alignmentPositions(7)).toEqual([6, 22, 38])
+    expect(alignmentPositions(14)).toEqual([6, 26, 46, 66])
+    expect(alignmentPositions(22)).toEqual([6, 26, 50, 74, 98])
+    expect(alignmentPositions(32)).toEqual([6, 34, 60, 86, 112, 138])
+    expect(alignmentPositions(40)).toEqual([6, 30, 58, 86, 114, 142, 170])
+  })
+
+  it('holds what the standard says level M holds', () => {
+    // Data codewords at level M, from the standard's table 7.
+    expect(dataCodewords(1)).toBe(16)
+    expect(dataCodewords(5)).toBe(86)
+    expect(dataCodewords(7)).toBe(124)
+    expect(dataCodewords(10)).toBe(216)
+    expect(dataCodewords(40)).toBe(2334)
+  })
+})
+
+describe('encoding', () => {
+  it('matches the known-good codes module for module', () => {
+    for (const fixture of fixtures.full) {
+      const code = encodeQr(fixture.text, { minVersion: fixture.version })
+      expect(code.version).toBe(fixture.version)
+      expect(code.size).toBe(17 + 4 * fixture.version)
+      expect(code.mask).toBe(fixture.mask)
+      expect(rows(code)).toEqual(fixture.rows)
+    }
+  })
+
+  // The largest codes are 177 modules a side: allow a loaded machine time.
+  it('matches at every version from 1 to 40, each filled to its last byte', { timeout: 30_000 }, async () => {
+    expect(fixtures.versions.map((fixture) => fixture.version)).toEqual(
+      Array.from({ length: 40 }, (_, index) => index + 1),
+    )
+    for (const fixture of fixtures.versions) {
+      const text = fixtures.filler.repeat(100).slice(0, fixture.length)
+      // The mask is chosen here up to version 12, past the first with
+      // version information; above that it is given, to keep this quick,
+      // and the choosing is checked on the move codes below.
+      const chosen = fixture.version <= 12 ? undefined : fixture.mask
+      const code = encodeQr(text, { minVersion: fixture.version, mask: chosen })
+      expect({ version: code.version, mask: code.mask }).toEqual({
+        version: fixture.version,
+        mask: fixture.mask,
+      })
+      expect(await digest(code)).toBe(fixture.sha256)
+      // Full: one byte more needs the next version.
+      if (fixture.version < 40) expect(encodeQr(text + 'x', { mask: 0 }).version).toBe(fixture.version + 1)
+    }
+  })
+
+  it('draws each of the eight masks as the standard defines it', { timeout: 15_000 }, async () => {
+    for (const fixture of fixtures.masks) {
+      const code = encodeQr(fixture.text, { mask: fixture.mask })
+      expect(code.mask).toBe(fixture.mask)
+      expect(await digest(code)).toBe(fixture.sha256)
+    }
+  })
+
+  it('chooses the smallest version and the mask with the lowest penalty, as the reference does', { timeout: 30_000 }, async () => {
+    for (const fixture of fixtures.codes) {
+      const code = encodeQr(fixture.text)
+      expect({ version: code.version, mask: code.mask }).toEqual({
+        version: fixture.version,
+        mask: fixture.mask,
+      })
+      expect(await digest(code)).toBe(fixture.sha256)
+      // And it is the lowest: no other mask scores less.
+      const chosen = penalty(code.modules)
+      for (let mask = 0; mask < 8; mask += 1) {
+        expect(penalty(encodeQr(fixture.text, { mask }).modules)).toBeGreaterThanOrEqual(chosen)
+      }
+    }
+  })
+
+  it('takes bytes as well as text, as UTF-8', () => {
+    const text = 'acorn meadow lantern'
+    expect(rows(encodeQr(new TextEncoder().encode(text)))).toEqual(rows(encodeQr(text)))
+    expect(encodeQr('é').modules).toEqual(encodeQr(Uint8Array.from([0xc3, 0xa9])).modules)
+  })
+
+  it('refuses what it cannot make', () => {
+    expect(() => encodeQr('x', { mask: 8 })).toThrow(RangeError)
+    expect(() => encodeQr('x', { mask: 1.5 })).toThrow(RangeError)
+    expect(() => encodeQr('x', { minVersion: 0 })).toThrow(RangeError)
+    expect(() => encodeQr('x', { minVersion: 41 })).toThrow(RangeError)
+    expect(() => encodeQr('x'.repeat(2332))).toThrow('too much')
+    expect(encodeQr('x'.repeat(2331)).version).toBe(40)
+  })
+})
+
+describe('the picture', () => {
+  it('draws each run of dark modules once, inside a quiet zone', () => {
+    const code: QrCode = {
+      version: 1,
+      size: 3,
+      mask: 0,
+      modules: [
+        [true, true, false],
+        [false, false, false],
+        [false, true, true],
+      ],
+    }
+    expect(qrPath(code)).toBe('M4 4h2v1h-2zM5 6h2v1h-2z')
+    expect(qrPath(code, 0)).toBe('M0 0h2v1h-2zM1 2h2v1h-2z')
+  })
+})
