+})
diff --git a/src/components/move/CodeScanner.tsx b/src/components/move/CodeScanner.tsx
new file mode 100644
index 0000000..a51a6e7
--- /dev/null
+++ b/src/components/move/CodeScanner.tsx
@@ -0,0 +1,115 @@
+import { useEffect, useRef, useState } from 'react'
+import { cameraProblem, openCamera, stopCamera, type QrDetector } from '../../lib/qrScan'
+
+/** How often a frame is looked at: often enough to feel instant, rarely enough to stay cool. */
+const LOOK_EVERY_MS = 250
+
+/**
+ * The camera, looking for the move's QR code. Mounted only after the
+ * gardener taps Scan, never before; the camera is let go the moment a code
+ * is read, Stop is pressed, the app goes out of sight, or this leaves the
+ * screen for any reason (the dialog closing included), whichever is first.
+ *
+ * The picture is only a viewfinder: what to do is said in words beside it,
+ * so it is hidden from assistive technology. Frames are looked at a few
+ * times a second by the browser's own detector; nothing is kept or sent.
+ */
+export function CodeScanner({
+  detector,
+  onRead,
+  onProblem,
+  onStop,
+}: {
+  detector: QrDetector
+  /** A code's text, read: the camera has already been let go. */
+  onRead: (text: string) => void
+  /** The camera could not be used, or stopped by itself: why, in words. */
+  onProblem: (message: string) => void
+  onStop: () => void
+}) {
+  const video = useRef<HTMLVideoElement>(null)
+  const stop = useRef<HTMLButtonElement>(null)
+  const [watching, setWatching] = useState(false)
+  const latest = useRef({ onRead, onProblem })
+  useEffect(() => {
+    latest.current = { onRead, onProblem }
+  })
+  // Scan was pressed and has gone: its place, and the focus, is Stop's.
+  useEffect(() => {
+    stop.current?.focus()
+  }, [])
+
+  useEffect(() => {
+    let stream: MediaStream | undefined
+    let timer: number | undefined
+    let done = false
+    const finish = () => {
+      done = true
+      window.clearTimeout(timer)
+      stopCamera(stream)
+      stream = undefined
+      if (video.current) video.current.srcObject = null
+    }
+    const look = async () => {
+      if (done || !video.current) return
+      try {
+        const found = (await detector.detect(video.current)).find((code) => code.rawValue)
+        if (done) return
+        if (found) {
+          finish()
+          latest.current.onRead(found.rawValue)
+          return
+        }
+      } catch {
+        // No frame yet, or one the detector could not use: look again.
+      }
+      if (!done) timer = window.setTimeout(() => void look(), LOOK_EVERY_MS)
+    }
+    const hidden = () => {
+      if (document.visibilityState !== 'hidden' || done) return
+      finish()
+      latest.current.onProblem('The camera stopped while the app was out of sight. Scan again when you are ready.')
+    }
+    document.addEventListener('visibilitychange', hidden)
+    openCamera().then(
+      (opened) => {
+        // Left before the camera answered: let it go straight away.
+        if (done) {
+          stopCamera(opened)
+          return
+        }
+        stream = opened
+        const element = video.current
+        if (element) {
+          element.srcObject = opened
+          void Promise.resolve(element.play()).catch(() => undefined)
+        }
+        setWatching(true)
+        void look()
+      },
+      (error: unknown) => {
+        if (done) return
+        finish()
+        latest.current.onProblem(cameraProblem(error))
+      },
+    )
+    return () => {
+      document.removeEventListener('visibilitychange', hidden)
+      finish()
+    }
+  }, [detector])
+
+  return (
+    <div className="move-scanner">
+      <video ref={video} className="move-camera" muted playsInline aria-hidden="true" />
+      <p className="move-progress" role="status">
+        {watching ? 'Point the camera at the QR code on your other device.' : 'Opening the camera…'}
+      </p>
+      <div className="form-actions">
+        <button ref={stop} className="secondary-button" type="button" onClick={onStop}>
+          Stop the camera
+        </button>
+      </div>
+    </div>
+  )
+}
