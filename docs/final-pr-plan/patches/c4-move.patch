+
+  it('says a QR code that is not a move code is not one, with the camera let go', async () => {
+    const { show } = fakeDetector()
+    const camera = fakeCamera()
+    const { file } = await moveFile()
+    const { onOpened, user } = renderDialog()
+    await chooseFile(user, file)
+    await user.click(await screen.findByRole('button', { name: 'Scan the QR code' }))
+    show('https://example.com/')
+    await waitFor(() => expect(screen.getByRole('alert')).toHaveTextContent('That QR code is not a move code.'))
+    expect(camera.track.stop).toHaveBeenCalled()
+    expect(screen.getByLabelText('The 12 words')).toHaveFocus()
+    expect(onOpened).not.toHaveBeenCalled()
+  })
+
+  it('lets the camera go on every way out', async () => {
+    fakeDetector()
+    const { file, words } = await moveFile()
+    const exits: Array<[string, (user: ReturnType<typeof userEvent.setup>) => Promise<void> | void]> = [
+      ['Stop', (user) => user.click(screen.getByRole('button', { name: 'Stop the camera' }))],
+      ['Cancel', (user) => user.click(screen.getByRole('button', { name: 'Cancel' }))],
+      [
+        'Escape',
+        () => {
+          fireEvent(screen.getByRole('dialog'), new Event('cancel', { cancelable: true }))
+        },
+      ],
+      ['another file', (user) => user.click(screen.getByRole('button', { name: 'Choose another file' }))],
+      [
+        'typing instead',
+        async (user) => {
+          await enter(user, screen.getByLabelText('The 12 words'), words.join(' '))
+          await user.click(screen.getByRole('button', { name: 'Open the file' }))
+        },
+      ],
+      [
+        'the app out of sight',
+        () => {
+          Object.defineProperty(document, 'visibilityState', { configurable: true, value: 'hidden' })
+          fireEvent(document, new Event('visibilitychange'))
+          Reflect.deleteProperty(document, 'visibilityState')
+        },
+      ],
+    ]
+    for (const [, leave] of exits) {
+      const camera = fakeCamera()
+      const view = renderDialog()
+      await chooseFile(view.user, file)
+      await view.user.click(await screen.findByRole('button', { name: 'Scan the QR code' }))
+      await screen.findByText('Point the camera at the QR code on your other device.')
+      expect(camera.track.stop).not.toHaveBeenCalled()
+      await leave(view.user)
+      await waitFor(() => expect(camera.track.stop).toHaveBeenCalled())
+      view.unmount()
+      document.body.replaceChildren()
+    }
+  })
+
+  it('lets the camera go when the dialog leaves the page', async () => {
+    fakeDetector()
+    const camera = fakeCamera()
+    const { file } = await moveFile()
+    const { unmount, user } = renderDialog()
+    await chooseFile(user, file)
+    await user.click(await screen.findByRole('button', { name: 'Scan the QR code' }))
+    await screen.findByText('Point the camera at the QR code on your other device.')
+    unmount()
+    expect(camera.track.stop).toHaveBeenCalled()
