@@ -0,0 +1,476 @@
+/**
+ * A small QR code encoder, written for the move between devices
+ * (components/move), so the one-time code can be shown as a picture to scan
+ * as well as words to type. Drawn on the device: nothing is fetched, and no
+ * dependency is added for it.
+ *
+ * Deliberately narrow, following ISO/IEC 18004:
+ *
+ * - byte mode only (the words are plain ASCII, and byte mode holds any text);
+ * - error correction level M, which survives about 15% of the code being
+ *   unreadable: a glare on a screen or a smudged lens;
+ * - the smallest version (size) of the 40 that holds the text;
+ * - all eight masks tried, and the one with the lowest penalty kept, by the
+ *   standard's four rules.
+ *
+ * The tests check it against codes made by an independent encoder, for
+ * every version and every mask, and the error correction against the
+ * standard's own worked examples.
+ *
+ * Loaded only with the move's screen, never with the garden.
+ */
+
+/** A finished code: `modules[y][x]` is true where the module is dark. */
+export interface QrCode {
+  version: number
+  /** The modules along each side: 17 + 4 × version. The quiet zone is not included. */
+  size: number
+  /** The mask pattern chosen, 0 to 7. */
+  mask: number
+  modules: boolean[][]
+}
+
+/**
+ * Error correction codewords per block, and the number of blocks, at level M
+ * for each version (index 0 unused). From the standard's table 9.
+ */
+const EC_CODEWORDS_PER_BLOCK = [
+  -1, 10, 16, 26, 18, 24, 16, 18, 22, 22, 26, 30, 22, 22, 24, 24, 28, 28, 26, 26, 26, 26, 28, 28,
+  28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28,
+]
+const EC_BLOCKS = [
+  -1, 1, 1, 1, 2, 2, 4, 4, 4, 5, 5, 5, 8, 9, 9, 10, 10, 11, 13, 14, 16, 17, 17, 18, 20, 21, 23, 25,
+  26, 28, 29, 31, 33, 35, 37, 38, 40, 43, 45, 47, 49,
+]
+
+/** Level M's two bits in the format information (L is 01, M 00, Q 11, H 10). */
+const LEVEL_M_BITS = 0b00
+
+/** The standard's weights for the four penalty rules. */
+const PENALTY_RUN = 3
+const PENALTY_BLOCK = 3
+const PENALTY_FINDER = 40
+const PENALTY_BALANCE = 10
+
+/** Modules left for data and error correction once every fixed pattern is drawn. */
+function rawDataModules(version: number): number {
+  let modules = (16 * version + 128) * version + 64
+  if (version >= 2) {
+    const alignments = Math.floor(version / 7) + 2
+    modules -= (25 * alignments - 10) * alignments - 55
+    if (version >= 7) modules -= 36
+  }
+  return modules
+}
+
+/** Data codewords a version holds at level M, once its error correction is set aside. */
+export function dataCodewords(version: number): number {
+  return Math.floor(rawDataModules(version) / 8) - EC_CODEWORDS_PER_BLOCK[version] * EC_BLOCKS[version]
+}
+
+/** Bits of the length field in byte mode: 8 up to version 9, 16 from 10. */
+function countBits(version: number): number {
+  return version < 10 ? 8 : 16
+}
+
+/** The smallest version whose level M holds this many bytes, if any does. */
+function smallestVersion(length: number, from: number): number | undefined {
+  for (let version = from; version <= 40; version += 1) {
+    if (4 + countBits(version) + 8 * length <= dataCodewords(version) * 8) return version
+  }
+  return undefined
+}
+
+// Arithmetic in GF(2^8) with the standard's polynomial x^8 + x^4 + x^3 + x^2 + 1.
+const EXP = new Uint8Array(510)
+const LOG = new Uint8Array(256)
+{
+  let value = 1
+  for (let power = 0; power < 255; power += 1) {
+    EXP[power] = value
+    EXP[power + 255] = value
+    LOG[value] = power
+    value <<= 1
+    if (value & 0x100) value ^= 0x11d
+  }
+}
+
+function multiply(a: number, b: number): number {
+  return a === 0 || b === 0 ? 0 : EXP[LOG[a] + LOG[b]]
+}
+
+/**
+ * The generator polynomial for `degree` error correction codewords: the
+ * product of (x - α^i) for i from 0 to degree - 1, highest power first, its
+ * leading 1 left out.
+ */
+function generator(degree: number): Uint8Array {
+  const coefficients = new Uint8Array(degree)
+  coefficients[degree - 1] = 1
+  let root = 1
+  for (let step = 0; step < degree; step += 1) {
+    for (let index = 0; index < degree; index += 1) {
+      coefficients[index] = multiply(coefficients[index], root)
+      if (index + 1 < degree) coefficients[index] ^= coefficients[index + 1]
+    }
+    root = multiply(root, 2)
+  }
+  return coefficients
+}
+
+/**
+ * The Reed-Solomon error correction codewords for one block of data: the
+ * remainder of the data, as a polynomial, divided by the generator.
+ */
+export function reedSolomon(data: Uint8Array, degree: number): Uint8Array {
+  const divisor = generator(degree)
+  const remainder = new Uint8Array(degree)
+  for (const byte of data) {
+    const factor = byte ^ remainder[0]
+    remainder.copyWithin(0, 1)
+    remainder[degree - 1] = 0
+    for (let index = 0; index < degree; index += 1) {
+      remainder[index] ^= multiply(divisor[index], factor)
+    }
+  }
+  return remainder
+}
+
+/** The data codewords: mode, length, the bytes, a terminator, then padding. */
+function dataStream(bytes: Uint8Array, version: number): Uint8Array {
+  const capacity = dataCodewords(version)
+  const bits: number[] = []
+  const push = (value: number, length: number) => {
+    for (let bit = length - 1; bit >= 0; bit -= 1) bits.push((value >>> bit) & 1)
+  }
+  push(0b0100, 4)
+  push(bytes.length, countBits(version))
+  for (const byte of bytes) push(byte, 8)
+  // Up to four zero bits end the data, then zeros to a whole byte.
+  push(0, Math.min(4, capacity * 8 - bits.length))
+  push(0, (8 - (bits.length % 8)) % 8)
+  const codewords = new Uint8Array(capacity)
+  for (let index = 0; index < bits.length; index += 1) {
+    codewords[index >>> 3] |= bits[index] << (7 - (index & 7))
+  }
+  // The rest is the standard's two padding bytes, in turn.
+  for (let index = bits.length / 8, pad = 0xec; index < capacity; index += 1, pad ^= 0xec ^ 0x11) {
+    codewords[index] = pad
+  }
+  return codewords
+}
+
+/**
+ * The data split into blocks, each given its error correction, then
+ * interleaved: the first codeword of every block, then the second, and so
+ * on, so a damaged patch of the code spreads its harm across the blocks.
+ */
+function interleaved(data: Uint8Array, version: number): Uint8Array {
+  const blocks = EC_BLOCKS[version]
+  const degree = EC_CODEWORDS_PER_BLOCK[version]
+  const total = Math.floor(rawDataModules(version) / 8)
+  const shortBlocks = blocks - (total % blocks)
+  const shortLength = Math.floor(total / blocks) - degree
+  const dataBlocks: Uint8Array[] = []
+  const ecBlocks: Uint8Array[] = []
+  for (let block = 0, at = 0; block < blocks; block += 1) {
+    const length = shortLength + (block < shortBlocks ? 0 : 1)
+    const part = data.subarray(at, at + length)
+    at += length
+    dataBlocks.push(part)
+    ecBlocks.push(reedSolomon(part, degree))
+  }
+  const result = new Uint8Array(total)
+  let at = 0
+  for (let index = 0; index <= shortLength; index += 1) {
+    for (const part of dataBlocks) {
+      // The short blocks have no codeword at the last index.
+      if (index < part.length) result[at++] = part[index]
+    }
+  }
+  for (let index = 0; index < degree; index += 1) {
+    for (const part of ecBlocks) result[at++] = part[index]
+  }
+  return result
+}
+
+/** Where the alignment patterns' centres fall along each axis. */
+export function alignmentPositions(version: number): number[] {
+  if (version === 1) return []
+  const count = Math.floor(version / 7) + 2
+  const step = Math.floor((version * 8 + count * 3 + 5) / (count * 4 - 4)) * 2
+  const positions = [6]
+  for (let position = 17 + 4 * version - 7; positions.length < count; position -= step) {
+    positions.splice(1, 0, position)
+  }
+  return positions
+}
+
+/** The mask patterns, by number: true where a data module is flipped. */
+const MASKS: ReadonlyArray<(x: number, y: number) => boolean> = [
+  (x, y) => (x + y) % 2 === 0,
+  (_x, y) => y % 2 === 0,
+  (x) => x % 3 === 0,
+  (x, y) => (x + y) % 3 === 0,
+  (x, y) => (Math.floor(x / 3) + Math.floor(y / 2)) % 2 === 0,
+  (x, y) => ((x * y) % 2) + ((x * y) % 3) === 0,
+  (x, y) => (((x * y) % 2) + ((x * y) % 3)) % 2 === 0,
+  (x, y) => (((x + y) % 2) + ((x * y) % 3)) % 2 === 0,
+]
+
+/** A code being drawn: its modules, and which of them are fixed patterns. */
+class Grid {
+  readonly size: number
+  readonly modules: boolean[][]
+  readonly fixed: boolean[][]
+
+  constructor(size: number) {
+    this.size = size
+    this.modules = Array.from({ length: size }, () => Array<boolean>(size).fill(false))
+    this.fixed = Array.from({ length: size }, () => Array<boolean>(size).fill(false))
+  }
+
+  set(x: number, y: number, dark: boolean) {
+    this.modules[y][x] = dark
+    this.fixed[y][x] = true
+  }
+}
+
+/** A finder pattern centred on (x, y), with its light separator. */
+function drawFinder(grid: Grid, x: number, y: number) {
+  for (let dy = -4; dy <= 4; dy += 1) {
+    for (let dx = -4; dx <= 4; dx += 1) {
+      const ring = Math.max(Math.abs(dx), Math.abs(dy))
+      const xx = x + dx
+      const yy = y + dy
+      if (xx >= 0 && xx < grid.size && yy >= 0 && yy < grid.size)
+        grid.set(xx, yy, ring !== 2 && ring !== 4)
+    }
+  }
+}
+
+/** The 15 format bits (level M and the mask, with their BCH check), in both places. */
+function drawFormat(grid: Grid, mask: number) {
+  const data = (LEVEL_M_BITS << 3) | mask
+  let remainder = data
+  for (let step = 0; step < 10; step += 1) remainder = (remainder << 1) ^ ((remainder >>> 9) * 0x537)
+  const bits = ((data << 10) | remainder) ^ 0x5412
+  const bit = (index: number) => ((bits >>> index) & 1) === 1
+  const size = grid.size
+  // Around the top-left finder.
+  for (let index = 0; index <= 5; index += 1) grid.set(8, index, bit(index))
+  grid.set(8, 7, bit(6))
+  grid.set(8, 8, bit(7))
+  grid.set(7, 8, bit(8))
+  for (let index = 9; index < 15; index += 1) grid.set(14 - index, 8, bit(index))
+  // Split between the other two finders, and the module that is always dark.
+  for (let index = 0; index < 8; index += 1) grid.set(size - 1 - index, 8, bit(index))
+  for (let index = 8; index < 15; index += 1) grid.set(8, size - 15 + index, bit(index))
+  grid.set(8, size - 8, true)
+}
+
+/** From version 7, the version number with its BCH check, in two 6 × 3 blocks. */
+function drawVersion(grid: Grid, version: number) {
+  if (version < 7) return
+  let remainder = version
+  for (let step = 0; step < 12; step += 1) remainder = (remainder << 1) ^ ((remainder >>> 11) * 0x1f25)
+  const bits = (version << 12) | remainder
+  for (let index = 0; index < 18; index += 1) {
+    const dark = ((bits >>> index) & 1) === 1
+    const a = grid.size - 11 + (index % 3)
+    const b = Math.floor(index / 3)
+    grid.set(a, b, dark)
+    grid.set(b, a, dark)
+  }
+}
+
+/** Every fixed pattern: timing, finders, alignment, and room for the format and version. */
+function drawFixedPatterns(grid: Grid, version: number) {
+  for (let index = 0; index < grid.size; index += 1) {
+    grid.set(6, index, index % 2 === 0)
+    grid.set(index, 6, index % 2 === 0)
+  }
+  drawFinder(grid, 3, 3)
+  drawFinder(grid, grid.size - 4, 3)
+  drawFinder(grid, 3, grid.size - 4)
+  const positions = alignmentPositions(version)
+  const last = positions.length - 1
+  for (let i = 0; i <= last; i += 1) {
+    for (let j = 0; j <= last; j += 1) {
+      // Not over the three finders' corners.
+      if ((i === 0 && j === 0) || (i === 0 && j === last) || (i === last && j === 0)) continue
+      for (let dy = -2; dy <= 2; dy += 1) {
+        for (let dx = -2; dx <= 2; dx += 1) {
+          grid.set(positions[i] + dx, positions[j] + dy, Math.max(Math.abs(dx), Math.abs(dy)) !== 1)
+        }
+      }
+    }
+  }
+  drawFormat(grid, 0)
+  drawVersion(grid, version)
+}
+
+/**
+ * The codewords laid in, bit by bit, in the standard's zigzag: two columns
+ * at a time from the right, up then down, stepping over the vertical timing
+ * pattern and every fixed module. Bits left over stay light.
+ */
+function drawCodewords(grid: Grid, codewords: Uint8Array) {
+  const size = grid.size
+  let index = 0
+  for (let right = size - 1; right >= 1; right -= 2) {
+    if (right === 6) right = 5
+    const upward = ((right + 1) & 2) === 0
+    for (let step = 0; step < size; step += 1) {
+      const y = upward ? size - 1 - step : step
+      for (let column = 0; column < 2; column += 1) {
+        const x = right - column
+        if (grid.fixed[y][x] || index >= codewords.length * 8) continue
+        grid.modules[y][x] = ((codewords[index >>> 3] >>> (7 - (index & 7))) & 1) === 1
+        index += 1
+      }
+    }
+  }
+}
+
+/** Flip every data module the mask chooses. Applying it twice undoes it. */
+function applyMask(grid: Grid, mask: number) {
+  const pattern = MASKS[mask]
+  for (let y = 0; y < grid.size; y += 1) {
+    for (let x = 0; x < grid.size; x += 1) {
+      if (!grid.fixed[y][x] && pattern(x, y)) grid.modules[y][x] = !grid.modules[y][x]
+    }
+  }
+}
+
+/**
+ * How many finder-like patterns (dark, light, dark × 3, light, dark, in
+ * 1:1:3:1:1, with four light modules on one side) end at this point of a
+ * line, given the last seven run lengths, newest first.
+ */
+function finderLike(runs: number[]): number {
+  const unit = runs[1]
+  const core =
+    unit > 0 && runs[2] === unit && runs[3] === unit * 3 && runs[4] === unit && runs[5] === unit
+  return (
+    (core && runs[0] >= unit * 4 && runs[6] >= unit ? 1 : 0) +
+    (core && runs[6] >= unit * 4 && runs[0] >= unit ? 1 : 0)
+  )
+}
+
+/** The penalty one row or column earns under rules 1 (runs) and 3 (finder-like patterns). */
+function linePenalty(line: (index: number) => boolean, size: number): number {
+  let penalty = 0
+  let colour = false
+  let run = 0
+  // The light quiet zone counts as part of the first and last runs.
+  const runs = [0, 0, 0, 0, 0, 0, 0]
+  const record = (length: number) => {
+    runs.pop()
+    runs.unshift(runs[0] === 0 ? length + size : length)
+  }
+  for (let index = 0; index < size; index += 1) {
+    if (line(index) === colour) {
+      run += 1
+      if (run === 5) penalty += PENALTY_RUN
+      else if (run > 5) penalty += 1
+    } else {
+      record(run)
+      if (!colour) penalty += finderLike(runs) * PENALTY_FINDER
+      colour = line(index)
+      run = 1
+    }
+  }
+  if (colour) {
+    record(run)
+    run = 0
+  }
+  record(run + size)
+  return penalty + finderLike(runs) * PENALTY_FINDER
+}
+
+/** The standard's penalty for a masked code: lower reads more reliably. */
+export function penalty(modules: boolean[][]): number {
+  const size = modules.length
+  let total = 0
+  for (let y = 0; y < size; y += 1) total += linePenalty((x) => modules[y][x], size)
+  for (let x = 0; x < size; x += 1) total += linePenalty((y) => modules[y][x], size)
+  // Rule 2: every 2 × 2 block of one colour.
+  for (let y = 0; y < size - 1; y += 1) {
+    for (let x = 0; x < size - 1; x += 1) {
+      const colour = modules[y][x]
+      if (colour === modules[y][x + 1] && colour === modules[y + 1][x] && colour === modules[y + 1][x + 1])
+        total += PENALTY_BLOCK
+    }
+  }
+  // Rule 4: how far the share of dark modules strays from half, in steps of 5%.
+  let dark = 0
+  for (const row of modules) for (const module of row) if (module) dark += 1
+  const area = size * size
+  total += (Math.ceil(Math.abs(dark * 20 - area * 10) / area) - 1) * PENALTY_BALANCE
+  return total
+}
+
+/**
+ * Encode text (as UTF-8) or bytes as a QR code: byte mode, level M, the
+ * smallest version that holds it (or `minVersion`, if larger), and the
+ * best mask unless `mask` names one. Throws when even version 40 is too
+ * small, which no move code comes near.
+ */
+export function encodeQr(
+  content: string | Uint8Array,
+  options: { mask?: number; minVersion?: number } = {},
+): QrCode {
+  const bytes = typeof content === 'string' ? new TextEncoder().encode(content) : content
+  const { mask: chosenMask, minVersion = 1 } = options
+  if (chosenMask !== undefined && !(Number.isInteger(chosenMask) && chosenMask >= 0 && chosenMask <= 7))
+    throw new RangeError('A mask is a whole number from 0 to 7.')
+  if (!Number.isInteger(minVersion) || minVersion < 1 || minVersion > 40)
+    throw new RangeError('A version is a whole number from 1 to 40.')
+  const version = smallestVersion(bytes.length, minVersion)
+  if (version === undefined) throw new RangeError('That is too much to hold in one QR code.')
+
+  const grid = new Grid(17 + 4 * version)
+  drawFixedPatterns(grid, version)
+  drawCodewords(grid, interleaved(dataStream(bytes, version), version))
+
+  let mask = chosenMask ?? 0
+  if (chosenMask === undefined) {
+    let lowest = Infinity
+    for (let candidate = 0; candidate < MASKS.length; candidate += 1) {
+      applyMask(grid, candidate)
+      drawFormat(grid, candidate)
+      const score = penalty(grid.modules)
+      if (score < lowest) {
+        lowest = score
+        mask = candidate
+      }
+      applyMask(grid, candidate)
+    }
+  }
+  applyMask(grid, mask)
+  drawFormat(grid, mask)
+  return { version, size: grid.size, mask, modules: grid.modules }
+}
+
+/**
+ * The dark modules as one SVG path, a unit square each, offset by the quiet
+ * zone: one element however large the code, rather than one per module.
+ * Runs along a row are joined into a single rectangle.
+ */
+export function qrPath(code: QrCode, quietZone = 4): string {
+  const parts: string[] = []
+  for (let y = 0; y < code.size; y += 1) {
+    let x = 0
+    while (x < code.size) {
+      if (!code.modules[y][x]) {
+        x += 1
+        continue
+      }
+      const start = x
+      while (x < code.size && code.modules[y][x]) x += 1
+      parts.push(`M${start + quietZone} ${y + quietZone}h${x - start}v1h-${x - start}z`)
+    }
+  }
+  return parts.join('')
+}
