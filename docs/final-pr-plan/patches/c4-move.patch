+++ b/src/lib/moveCode.test.ts
@@ -0,0 +1,158 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { RECOVERY_WORDS } from '../data/recoveryWords'
+import {
+  codeHoldsTogether,
+  MOVE_CODE_LENGTH,
+  moveSecret,
+  nearestWords,
+  newMoveCode,
+  readMoveCode,
+} from './moveCode'
+import * as sealing from './sealing'
+
+// The random source, watched: real unless a test hands it bytes of its own.
+vi.mock('./sealing', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('./sealing')>()
+  return { ...actual, randomBytes: vi.fn(actual.randomBytes) }
+})
+
+afterEach(() => {
+  vi.mocked(sealing.randomBytes).mockClear()
+})
+
+/** The 11-bit number each word stands for. */
+const indexOf = (word: string) => RECOVERY_WORDS.indexOf(word)
+
+/** A code's 132 bits as a string of 0s and 1s. */
+const bitsOf = (words: readonly string[]) =>
+  words.map((word) => indexOf(word).toString(2).padStart(11, '0')).join('')
+
+async function sha256(bytes: Uint8Array): Promise<Uint8Array> {
+  return new Uint8Array(await crypto.subtle.digest('SHA-256', Uint8Array.from(bytes)))
+}
+
+describe('a new move code', () => {
+  it('is 12 words from the lock’s list, from 128 random bits', async () => {
+    const words = await newMoveCode()
+    expect(words).toHaveLength(MOVE_CODE_LENGTH)
+    for (const word of words) expect(RECOVERY_WORDS).toContain(word)
+    expect(sealing.randomBytes).toHaveBeenCalledWith(16)
+  })
+
+  it('carries the 128 bits in order, then the first four bits of their SHA-256', async () => {
+    const key = Uint8Array.from({ length: 16 }, (_, index) => index * 17 + 3)
+    vi.mocked(sealing.randomBytes).mockReturnValueOnce(key)
+    const words = await newMoveCode()
+    const bits = bitsOf(words)
+    expect(bits).toHaveLength(132)
+    const keyBits = Array.from(key, (byte) => byte.toString(2).padStart(8, '0')).join('')
+    expect(bits.slice(0, 128)).toBe(keyBits)
+    const check = (await sha256(key))[0] >>> 4
+    expect(bits.slice(128)).toBe(check.toString(2).padStart(4, '0'))
+  })
+
+  it('is all the list’s first word for nothing but zeros, but for the check', async () => {
+    vi.mocked(sealing.randomBytes).mockReturnValueOnce(new Uint8Array(16))
+    const words = await newMoveCode()
+    // SHA-256 of 16 zero bytes begins 0x37: the check is 0b0011.
+    expect(words.slice(0, 11)).toEqual(Array(11).fill(RECOVERY_WORDS[0]))
+    expect(words[11]).toBe(RECOVERY_WORDS[0b0011])
+  })
+
+  it('is new every time', async () => {
+    const codes = new Set<string>()
+    for (let round = 0; round < 20; round += 1) codes.add((await newMoveCode()).join(' '))
+    expect(codes.size).toBe(20)
+  })
+})
+
+describe('words and key', () => {
+  it('go round: every new code holds together, and reads back as itself', async () => {
+    for (let round = 0; round < 25; round += 1) {
+      const words = await newMoveCode()
+      expect(await codeHoldsTogether(words)).toBe(true)
+      expect(readMoveCode(words.join(' '))).toEqual({ ok: true, words })
+    }
+  })
+
+  it('lock the file with the words, lower case, one space apart', async () => {
+    const words = await newMoveCode()
+    expect(moveSecret(words)).toBe(words.join(' '))
+    expect(moveSecret(words)).toMatch(/^[a-z]+( [a-z]+){11}$/)
+  })
+
+  it('refuse a word changed to another word on the list, by its check', async () => {
+    const words = await newMoveCode()
+    let refused = 0
+    // Each of the other 2,047 words in the last place: the check lets
+    // through only the few that happen to share it, one in sixteen.
+    for (const other of RECOVERY_WORDS) {
+      if (other === words[11]) continue
+      if (!(await codeHoldsTogether([...words.slice(0, 11), other]))) refused += 1
+    }
+    expect(refused).toBeGreaterThan(1800)
+  })
+
+  it('refuse two words swapped, almost always', async () => {
+    let refused = 0
+    for (let round = 0; round < 32; round += 1) {
+      const words = await newMoveCode()
+      if (words[0] === words[1]) continue
+      if (!(await codeHoldsTogether([words[1], words[0], ...words.slice(2)]))) refused += 1
+    }
+    expect(refused).toBeGreaterThan(20)
+  })
+
+  it('refuse the wrong number of words, or a word not on the list', async () => {
+    const words = await newMoveCode()
+    expect(await codeHoldsTogether(words.slice(1))).toBe(false)
+    expect(await codeHoldsTogether([...words.slice(1), 'zzz'])).toBe(false)
+  })
+})
+
+describe('reading a code as it was typed', () => {
+  const code = 'acorn meadow lantern willow tulip harbor wren velvet cactus bamboo zinnia almond'.split(' ')
+
+  it('forgives capitals, extra spaces, line breaks and the numbers beside the words', () => {
+    const messy = '  1. ACORN\n2.  meadow   Lantern willow\r\n\t5) tulip ,harbor  wren\nVelvet cactus bamboo zinnia almond  '
+    expect(readMoveCode(messy)).toEqual({ ok: true, words: code })
+  })
+
+  it('names a misspelt word and offers the nearest on the list', () => {
+    expect(readMoveCode('acorn medow')).toEqual({
+      ok: false,
+      problem: '“medow” is not one of the code’s words. Did you mean “meadow”?',
+    })
+    // Two letters swapped count as one slip.
+    expect(nearestWords('aocrn')).toContain('acorn')
+    expect(nearestWords('meadow')).toEqual(['meadow'])
+  })
+
+  it('offers up to three near words, and says so plainly when none is near', () => {
+    expect(nearestWords('bat').length).toBeLessThanOrEqual(3)
+    expect(nearestWords('bat').length).toBeGreaterThan(0)
+    const far = readMoveCode('acorn qqqqqqqqqqqq')
+    expect(far).toEqual({
+      ok: false,
+      problem: '“qqqqqqqqqqqq” is not one of the code’s words. Check it against your other device.',
+    })
+    const several = readMoveCode('acorn bakr')
+    expect(several.ok).toBe(false)
+    if (!several.ok) expect(several.problem).toMatch(/^“bakr” is not one of the code’s words\. Did you mean “[a-z]+”(, “[a-z]+”)*( or “[a-z]+”)?\?$/)
+  })
+
+  it('counts the words when there are too few or too many', () => {
+    expect(readMoveCode('')).toEqual({ ok: false, problem: 'Type the 12 words your other device shows.' })
+    expect(readMoveCode('  \n ')).toEqual({ ok: false, problem: 'Type the 12 words your other device shows.' })
+    expect(readMoveCode('acorn')).toEqual({ ok: false, problem: 'That is 1 word. The code has 12.' })
+    expect(readMoveCode(Array(13).fill('acorn').join(' '))).toEqual({
+      ok: false,
+      problem: 'That is 13 words. The code has 12.',
+    })
+  })
+
+  it('reads letters made another way the same (NFKC)', () => {
+    // Fullwidth letters, as some keyboards type them, are the same words.
+    expect(readMoveCode('ａｃｏｒｎ')).toEqual({ ok: false, problem: 'That is 1 word. The code has 12.' })
+  })
+})
diff --git a/src/lib/moveCode.ts b/src/lib/moveCode.ts
new file mode 100644
index 0000000..ad43c4b
--- /dev/null
+++ b/src/lib/moveCode.ts
@@ -0,0 +1,182 @@
+import { RECOVERY_WORDS } from '../data/recoveryWords'
+import { randomBytes } from './sealing'
+
+/**
+ * The one-time code that opens a move file (components/move): 12 words from
+ * the garden lock's list of 2,048 (data/recoveryWords), shown once on the old
+ * device and typed or scanned on the new one.
+ *
+ * Twelve words of 11 bits carry 132 bits: 128 of them are fresh randomness,
+ * and the last 4 are a check, the first 4 bits of the SHA-256 of those 128,
+ * as BIP-39 lays out its 12-word phrases. The check catches a word typed as
+ * another word on the list, or two swapped, at once, before the slow work of
+ * opening the file starts. It adds nothing to the strength, which stays at
+ * 128 bits: beyond guessing by anyone, with or without the file.
+ *
+ * The file's key is made from the words themselves, in lower case with one
+ * space between them, by the protected backup's own derivation
+ * (lib/sealedBackup: PBKDF2-HMAC-SHA-256, 600,000 rounds, a fresh salt, then
+ * AES-GCM 256). So the move file is an ordinary protected backup, and a
+ * protected backup's passphrase prompt opens it too, given the words exactly.
+ *
+ * Nothing here stores anything.
+ */
+
+export const MOVE_CODE_LENGTH = 12
+
+/** The randomness in a code: 128 bits. */
+const KEY_BYTES = 16
+/** Bits each word carries: log2 of the list's 2,048 words. */
+const BITS_PER_WORD = 11
+
+const positions = new Map(RECOVERY_WORDS.map((word, index) => [word, index]))
+
+/** The 4-bit check for 16 bytes: the top of the first byte of their SHA-256. */
+async function checkOf(key: Uint8Array): Promise<number> {
+  const copy = new Uint8Array(key.length)
+  copy.set(key)
+  const hash = new Uint8Array(await crypto.subtle.digest('SHA-256', copy))
+  return hash[0] >>> 4
+}
+
+/** Bytes and a 4-bit check, as 12 words: the bits read 11 at a time, in order. */
+function toWords(key: Uint8Array, check: number): string[] {
+  const words: string[] = []
+  let pending = 0
+  let bits = 0
+  const take = (value: number, width: number) => {
+    pending = (pending << width) | value
+    bits += width
+    while (bits >= BITS_PER_WORD) {
+      bits -= BITS_PER_WORD
+      words.push(RECOVERY_WORDS[(pending >>> bits) & 0x7ff])
+      pending &= (1 << bits) - 1
+    }
+  }
+  for (const byte of key) take(byte, 8)
+  take(check, 4)
+  return words
+}
+
+/** Twelve known words back to their 16 bytes and their check. */
+function fromWords(words: readonly string[]): { key: Uint8Array; check: number } {
+  const key = new Uint8Array(KEY_BYTES)
+  let pending = 0
+  let bits = 0
+  let at = 0
+  for (const word of words) {
+    pending = (pending << BITS_PER_WORD) | (positions.get(word) ?? 0)
+    bits += BITS_PER_WORD
+    while (bits >= 8 && at < KEY_BYTES) {
+      bits -= 8
+      key[at] = (pending >>> bits) & 0xff
+      at += 1
+      pending &= (1 << bits) - 1
+    }
+  }
+  return { key, check: pending & 0xf }
+}
+
+/** A new one-time code, from the platform's cryptographic randomness. */
+export async function newMoveCode(): Promise<string[]> {
+  const key = randomBytes(KEY_BYTES)
+  return toWords(key, await checkOf(key))
+}
+
+/** Whether 12 known words carry their own check: a code as it was made. */
+export async function codeHoldsTogether(words: readonly string[]): Promise<boolean> {
+  if (words.length !== MOVE_CODE_LENGTH || words.some((word) => !positions.has(word))) return false
+  const { key, check } = fromWords(words)
+  return (await checkOf(key)) === check
+}
+
+/** The secret the move file is locked with: the words, lower case, one space apart. */
+export function moveSecret(words: readonly string[]): string {
+  return words.join(' ')
+}
+
+/**
+ * Edits between two words, a swap of neighbouring letters counting as one
+ * (optimal string alignment), stopping early once past `limit`.
+ */
+function distance(a: string, b: string, limit: number): number {
+  if (Math.abs(a.length - b.length) > limit) return limit + 1
+  let before: number[] = []
+  let previous = Array.from({ length: b.length + 1 }, (_, index) => index)
+  for (let i = 1; i <= a.length; i += 1) {
+    const current = [i]
+    let best = i
+    for (let j = 1; j <= b.length; j += 1) {
+      const cost = a[i - 1] === b[j - 1] ? 0 : 1
+      let value = Math.min(previous[j] + 1, current[j - 1] + 1, previous[j - 1] + cost)
+      if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1])
+        value = Math.min(value, before[j - 2] + 1)
+      current.push(value)
+      best = Math.min(best, value)
+    }
+    if (best > limit) return limit + 1
+    before = previous
+    previous = current
+  }
+  return previous[b.length]
+}
+
+/** Up to three words on the list closest to one that is not, within two edits. */
+export function nearestWords(word: string): string[] {
+  let closest = 3
+  let found: string[] = []
+  for (const candidate of RECOVERY_WORDS) {
+    const edits = distance(word, candidate, Math.min(closest, 2))
+    if (edits < closest) {
+      closest = edits
+      found = [candidate]
+    } else if (edits === closest && edits <= 2) {
+      found.push(candidate)
+    }
+  }
+  return found.slice(0, 3)
+}
+
+function quoted(words: readonly string[]): string {
+  const marked = words.map((word) => `“${word}”`)
+  return marked.length === 1 ? marked[0] : `${marked.slice(0, -1).join(', ')} or ${marked[marked.length - 1]}`
+}
+
+export type MoveCodeReading = { ok: true; words: string[] } | { ok: false; problem: string }
+
+/**
+ * Read a code as it was typed, pasted or scanned: in any case, across lines
+ * or on one, with numbers or without, and with as many spaces as anyone
+ * likes. A word not on the list is named, with the nearest that are; how
+ * many words there are is said. None of this helps anyone without the
+ * code: the list is in the app for anyone to read.
+ *
+ * Whether the words carry their check is a second, slower question
+ * (`codeHoldsTogether`), asked once they all read.
+ */
+export function readMoveCode(text: string): MoveCodeReading {
+  const words = text
+    .normalize('NFKC')
+    .toLowerCase()
+    .split(/[^a-z]+/)
+    .filter(Boolean)
+  if (words.length === 0)
+    return { ok: false, problem: `Type the ${MOVE_CODE_LENGTH} words your other device shows.` }
+  const stranger = words.find((word) => !positions.has(word))
+  if (stranger !== undefined) {
+    const near = nearestWords(stranger)
+    return {
+      ok: false,
+      problem: near.length
+        ? `“${stranger}” is not one of the code’s words. Did you mean ${quoted(near)}?`
+        : `“${stranger}” is not one of the code’s words. Check it against your other device.`,
+    }
+  }
+  if (words.length !== MOVE_CODE_LENGTH) {
+    return {
+      ok: false,
+      problem: `That is ${words.length} ${words.length === 1 ? 'word' : 'words'}. The code has ${MOVE_CODE_LENGTH}.`,
+    }
+  }
+  return { ok: true, words }
+}
