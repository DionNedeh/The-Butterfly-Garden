+    const { onOpened, user } = renderDialog()
+    await chooseFile(user, file)
+    const scan = await screen.findByRole('button', { name: 'Scan the QR code' })
+    expect(screen.getByRole('dialog')).toHaveAccessibleDescription(/Scan its QR code, or type the words in order\./)
+    expect(camera.getUserMedia).not.toHaveBeenCalled()
+
+    await user.click(scan)
+    expect(camera.getUserMedia).toHaveBeenCalledWith({
+      video: { facingMode: { ideal: 'environment' } },
+      audio: false,
+    })
+    expect(screen.getByRole('button', { name: 'Stop the camera' })).toHaveFocus()
+    expect(await screen.findByText('Point the camera at the QR code on your other device.')).toBeInTheDocument()
+    const video = document.querySelector('video')!
+    expect(video).toHaveAttribute('aria-hidden', 'true')
+    expect(video.srcObject).toBe(camera.stream)
+
+    show(words.join(' '))
+    await waitFor(() => expect(camera.track.stop).toHaveBeenCalled())
+    await waitFor(() => expect(onOpened).toHaveBeenCalledWith(PLAIN, 'move'))
