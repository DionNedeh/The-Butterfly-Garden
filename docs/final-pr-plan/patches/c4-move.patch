+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cameraProblem, openCamera, qrDetector, stopCamera } from './qrScan'
+
+function camera() {
+  const getUserMedia = vi.fn(() => Promise.resolve({ getTracks: () => [] } as unknown as MediaStream))
+  Object.defineProperty(navigator, 'mediaDevices', { configurable: true, value: { getUserMedia } })
+  return getUserMedia
+}
+
+function detector(formats: string[] | Error) {
+  const made: unknown[] = []
+  class BarcodeDetector {
+    static getSupportedFormats = vi.fn(() =>
+      formats instanceof Error ? Promise.reject(formats) : Promise.resolve(formats),
+    )
+    constructor(options: unknown) {
+      made.push(options)
+    }
+    detect = vi.fn(() => Promise.resolve([]))
+  }
+  vi.stubGlobal('BarcodeDetector', BarcodeDetector)
+  return made
+}
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+  Reflect.deleteProperty(navigator, 'mediaDevices')
+})
+
+describe('whether to offer a scan', () => {
+  it('needs BarcodeDetector, with QR codes among its formats, and a camera', async () => {
+    expect(await qrDetector()).toBeUndefined()
+
+    detector(['qr_code'])
+    expect(await qrDetector()).toBeUndefined()
+
+    const getUserMedia = camera()
+    const made = detector(['ean_13', 'qr_code'])
+    expect(await qrDetector()).toBeDefined()
+    expect(made).toEqual([{ formats: ['qr_code'] }])
+    // Asking touches no camera.
+    expect(getUserMedia).not.toHaveBeenCalled()
+
+    detector(['ean_13'])
+    expect(await qrDetector()).toBeUndefined()
+
+    detector(new Error('not supported'))
+    expect(await qrDetector()).toBeUndefined()
+  })
+})
+
+describe('the camera', () => {
+  it('asks for the one facing away, and no sound', async () => {
+    const getUserMedia = camera()
+    await openCamera()
+    expect(getUserMedia).toHaveBeenCalledWith({ video: { facingMode: { ideal: 'environment' } }, audio: false })
+  })
+
+  it('is let go track by track, and nothing is asked of a camera never opened', () => {
+    const tracks = [{ stop: vi.fn() }, { stop: vi.fn() }]
+    stopCamera({ getTracks: () => tracks } as unknown as MediaStream)
+    for (const track of tracks) expect(track.stop).toHaveBeenCalledOnce()
+    expect(() => stopCamera(undefined)).not.toThrow()
+  })
+
+  it('says why it did not open, always with the words as the way on', () => {
+    const named = (name: string) => Object.assign(new Error('no'), { name })
+    expect(cameraProblem(named('NotAllowedError'))).toBe(
+      'The camera was not allowed, so nothing was scanned. You can type the 12 words instead.',
+    )
+    expect(cameraProblem(named('SecurityError'))).toMatch(/^The camera was not allowed/)
+    expect(cameraProblem(named('NotFoundError'))).toBe('No camera was found here. You can type the 12 words instead.')
+    expect(cameraProblem(named('OverconstrainedError'))).toMatch(/^No camera was found/)
+    expect(cameraProblem(named('NotReadableError'))).toBe(
+      'The camera is busy with something else just now. You can type the 12 words instead.',
+    )
+    expect(cameraProblem(named('AbortError'))).toMatch(/^The camera is busy/)
+    expect(cameraProblem(new Error('odd'))).toBe('The camera could not be opened. You can type the 12 words instead.')
+    expect(cameraProblem('a string')).toMatch(/^The camera could not be opened/)
+    expect(cameraProblem(null)).toMatch(/^The camera could not be opened/)
+  })
+})
