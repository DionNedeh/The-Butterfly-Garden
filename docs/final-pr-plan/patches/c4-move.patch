+
+  it('lets go of a camera that answers after the step was left', async () => {
+    fakeDetector()
+    const camera = fakeCamera({ later: true })
+    const { file } = await moveFile()
+    const { user } = renderDialog()
+    await chooseFile(user, file)
+    await user.click(await screen.findByRole('button', { name: 'Scan the QR code' }))
+    expect(screen.getByText('Opening the camera…')).toBeInTheDocument()
+    await user.click(screen.getByRole('button', { name: 'Stop the camera' }))
+    await act(async () => {
+      camera.answer()
+      await Promise.resolve()
+    })
+    expect(camera.track.stop).toHaveBeenCalled()
+    await waitFor(() => expect(screen.getByRole('button', { name: 'Scan the QR code' })).toHaveFocus())
+  })
+
+  it('says why the camera would not open, and offers the words', async () => {
+    fakeDetector()
+    fakeCamera({ refuse: 'NotAllowedError' })
+    const { file } = await moveFile()
+    const { user } = renderDialog()
+    await chooseFile(user, file)
+    await user.click(await screen.findByRole('button', { name: 'Scan the QR code' }))
+    await waitFor(() => expect(screen.getByRole('alert')).toHaveTextContent(
+      'The camera was not allowed, so nothing was scanned. You can type the 12 words instead.',
+    ))
+    await waitFor(() => expect(screen.getByRole('button', { name: 'Scan the QR code' })).toHaveFocus())
+    expect(document.querySelector('video')).toBeNull()
+  })
+
+  it('looks again after a frame the detector could not use', async () => {
+    const { detect, show } = fakeDetector()
+    fakeCamera()
+    detect.mockRejectedValueOnce(new Error('InvalidStateError'))
+    const { file, words } = await moveFile()
+    const { onOpened, user } = renderDialog()
+    await chooseFile(user, file)
+    await user.click(await screen.findByRole('button', { name: 'Scan the QR code' }))
+    show(words.join(' '))
+    await waitFor(() => expect(onOpened).toHaveBeenCalledWith(PLAIN, 'move'), { timeout: 3000 })
+    expect(detect.mock.calls.length).toBeGreaterThanOrEqual(2)
+  })
+})
