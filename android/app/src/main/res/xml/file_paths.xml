<?xml version="1.0" encoding="utf-8"?>
<!--
  The only files this app ever hands to another app through its FileProvider:
  a photo that a file picker's camera option saves into the app's own
  Pictures folder (Capacitor's BridgeWebChromeClient). Nothing else is shared.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="captured_images" path="Pictures/" />
</paths>
