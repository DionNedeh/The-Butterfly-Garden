<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+. The garden is never copied to cloud backup (Google Drive).
  Direct phone-to-phone transfer moves everything except the Garden Pass
  record: the new phone asks Google Play for itself rather than inheriting
  an allowance it never earned.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="garden_pass.xml" />
    </device-transfer>
</data-extraction-rules>
