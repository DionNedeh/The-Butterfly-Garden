<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older, where one set of rules covers both cloud backup and
  device transfer. Excluding everything keeps the garden out of Google Drive.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
